# Environment variables for scalerstudios.com
#
# Server-side (used by the /api serverless functions on Vercel). Set them in
# Vercel → Project "scalerstudios" → Settings → Environment Variables, then
# redeploy. For local `vercel dev`, copy this file to .env.local.
# NEVER commit real values.

# MongoDB connection string (Atlas SRV URL): CMS page copy + lead submissions
MONGO_URI=

# Admin auth header value for /admin-scalerstudios. Must match KEY in src/pages/AdminPanel.jsx
ADMIN_KEY=

# ImageKit credentials (media uploads from the admin panel)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Resend API key: contact-form emails from noreply@updates.scalerstudios.com
RESEND_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Client-side (inlined into the JS bundle at BUILD time, so a redeploy is
# needed after changing them). Leave empty to disable a pixel.
# ──────────────────────────────────────────────────────────────────────────

# Meta Pixel ID (Events Manager → Data sources → your pixel), e.g. 1234567890
VITE_META_PIXEL_ID=

# GA4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA4_ID=

# Google Ads conversion ID and the "Lead" conversion label, e.g. AW-123456789 and AbC-dEfGhIjK
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=

# Optional: booking link (Calendly, GoHighLevel...) shown on /thank-you
VITE_BOOKING_URL=
